// Kajla Society — Prisma schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH & USERS
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  MODERATOR
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  avatar       String?
  role         Role     @default(MEMBER)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles  Article[]
  events    Event[]
  notices   Notice[]
  pages     Page[]

  @@index([role])
}

// ============================================================
// CONTENT — Pages, Articles, Events, Notices
// ============================================================

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleBn     String?
  content     String   @db.Text // Tiptap JSON
  contentBn   String?  @db.Text
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([slug])
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  nameBn   String?
  articles Article[]
}

model Article {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  titleBn      String?
  excerpt      String?
  content      String   @db.Text // Tiptap JSON
  contentBn    String?  @db.Text
  coverImage   String?
  isPublished  Boolean  @default(false)
  publishedAt  DateTime?
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([isPublished, publishedAt])
  @@index([slug])
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleBn     String?
  description String   @db.Text
  coverImage  String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([startsAt])
}

model Notice {
  id          String   @id @default(cuid())
  title       String
  titleBn     String?
  content     String   @db.Text
  attachment  String? // PDF URL
  isPinned    Boolean  @default(false)
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
}

// ============================================================
// PEOPLE — Committee, Residents
// ============================================================

model CommitteeMember {
  id        String   @id @default(cuid())
  name      String
  nameBn    String?
  role      String   // e.g. "President", "General Secretary"
  roleBn    String?
  photo     String?
  bio       String?  @db.Text
  email     String?
  phone     String?
  term      String   // e.g. "2024-2026"
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([term, order])
}

model Resident {
  id           String   @id @default(cuid())
  fullName     String
  fullNameBn   String?
  houseNo      String
  road         String?
  block        String?
  phone        String?
  email        String?
  membershipNo String?  @unique
  photo        String?
  isVerified   Boolean  @default(false)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([houseNo])
  @@index([fullName])
}

// ============================================================
// FACILITIES & GALLERY
// ============================================================

enum FacilityCategory {
  RELIGIOUS
  EDUCATIONAL
  HEALTH_EMERGENCY
  CONSTRUCTION
  LOCAL_SERVICES
  GOVERNMENT
  COMMUNITY_ORG
}

model Facility {
  id            String           @id @default(cuid())
  category      FacilityCategory
  name          String
  nameBn        String?
  description   String?          @db.Text
  address       String?
  phone         String?
  donationPhone String?
  email         String?
  website       String?
  image         String?
  committee     Json?            // [{ name, title, phone, photo }]
  eventPhotos   String[]         // image URLs of the institute's events
  order         Int              @default(0)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([category, order])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  quote     String   @db.Text
  avatar    String?
  rating    Int      @default(5)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

enum MediaType {
  PHOTO
  VIDEO
}

model Gallery {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleBn     String?
  description String?
  coverImage  String?
  type        MediaType @default(PHOTO)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media Media[]
}

model Media {
  id        String    @id @default(cuid())
  url       String
  thumbnail String?
  caption   String?
  type      MediaType
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  galleryId String?
  gallery   Gallery? @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, order])
}

// ============================================================
// SERVICE APPLICATIONS
// ============================================================

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model MembershipApplication {
  id                      String   @id @default(cuid())

  // Membership Type & Declaration
  membershipType          String   @default("Life")
  agreedDeclaration       Boolean  @default(false)
  proposerName            String?
  proposerMembershipNo    String?
  seconderName            String?
  seconderMembershipNo    String?

  // Personal Information
  fullName                String
  fullNameBn              String?
  fatherName              String?
  motherName              String?
  spouseName              String?
  dateOfBirth             DateTime?
  gender                  String?
  bloodGroup              String?
  profession              String?

  // Contact Information
  email                   String
  mobile                  String
  officePhone             String?
  residencePhone          String?

  // Children (JSON array of {name, dob, school?})
  children                Json?

  // Professional Information
  designation             String?
  organization            String?

  // Address & Property
  residenceAddress        String?
  propertyOwner           String?
  propertyScheduleSummary String?
  relationshipToProperty  String?

  // Documents
  photoUrl                String?
  nidUrl                  String?
  taxReceiptUrl           String?

  status                  ApplicationStatus @default(PENDING)
  adminNote               String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([status])
}

model CarStickerApplication {
  id            String   @id @default(cuid())
  fullName      String
  email         String
  phone         String
  houseNo       String
  vehicleType   String   // car, bike, etc.
  brandModel    String
  registrationNo String
  color         String?
  documents     String[]
  status        ApplicationStatus @default(PENDING)
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

enum AdoptionTarget {
  ROAD
  GATE
}

model AdoptionRequest {
  id          String   @id @default(cuid())
  target      AdoptionTarget
  applicantName String
  email       String
  phone       String
  organization String?
  locationRef String   // road name / gate number
  message     String?  @db.Text
  status      ApplicationStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([target, status])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// ============================================================
// SITE SETTINGS
// ============================================================

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ============================================================
// HERO SLIDER — Admin-controlled homepage banner slides
// ============================================================

model HeroSlide {
  id           String   @id @default(cuid())
  image        String   // image URL (/uploads/... or external)
  title        String?
  titleBn      String?
  subtitle     String?
  subtitleBn   String?
  ctaLabel     String?  // button text, e.g. "Become a Member"
  ctaHref      String?  // button link
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, order])
}
