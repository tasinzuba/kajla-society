# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL — Neon)
# Pooled connection — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct (non-pooled) connection — used by prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Kajla Society <no-reply@kajla.org>"

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
